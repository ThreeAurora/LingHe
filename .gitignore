# 本地配置（含 API key 等私密信息，不入库；模板见 config.example.json）
/config.json

# 编译缓存（重跑即回，防丢价值为零）
__pycache__/

# 底库二进制缓存（可由文本词库再生，且会随词频更新频繁变化）
dicts/.cache.bin
dicts/.cache_mini.bin

# OpenSubtitles 下载残页（404 响应体，无价值）
cache/tmp/corpus/opensub_raw.zip

# 神经模型权重（114MB，fetch_model.py 从 hf-mirror 再生，不入库）
ai_neural/**/*.onnx

# LLM 模型权重（~1.5GB，fetch_qwen.py 从 hf-mirror 再生，不入库）
ai_llm/qwen25-05b-hf/
ai_llm/*.gguf
ai_llm/llama/
ai_llm/llama-cpu.zip

# PyInstaller 打包产物
build/
dist/
LingHe.spec

# 环境安装包（本地 wheel 等大货，不入库）
cache/tmp/*.whl

# 探针/遗留文件归档（探针脚本、Ark 调试件、接龙联想生成物等，一次性使用后归档）
cache/archive/

# 大文件不入库（GitHub 100MB 上限；语料原始件可由 fetch 脚本再生，lexicon.db 是孤儿产物）
cache/tmp/subtlex/zh_mono.txt.gz
dicts/lexicon.db

# 运行时日志（每次打字都在滚，1026 行噪音，无回看价值）
linghe.log

# cache/tmp 临时区整体不入库：探针脚本、语料原始件（TED2020 等）、
# librime/octagram/darts-clone 第三方源码包——都是一次性工具，用完即弃
cache/tmp/

# 训练大文件不入库（GB 级，gen_data.py / preconvert.py 可再生）：
# gen_v4.jsonl 1.34GB 语料、mm/ 预编码 memmap 数组 1.7GB
train/data/*.jsonl
train/data/mm/
